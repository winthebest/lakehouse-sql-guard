[25.7143, "o", "    18:31:31  Completed successfully\r\n"]
[25.7145, "o", "    18:31:31  \r\n"]
[25.7148, "o", "    18:31:31  Done. PASS=7 WARN=0 ERROR=0 SKIP=0 NO-OP=0 REUSED=0 TOTAL=7\r\n"]
[26.0518, "o", "\u001b[90m   # Every dbt test passes. Nothing in dbt knows the feature uses late-arriving rows.\u001b[0m\r\n"]
[26.0518, "o", "\r\n\u001b[1;36m== 3/11  sqlguard leakage dbt: the leak, where it is, and a fix\u001b[0m\r\n\u001b[90m   # The finding is attributed to the intermediate model, not to training_churn,\u001b[0m\r\n\u001b[90m   # and replay over the snapshot history confirms the feature values differ.\u001b[0m\r\n"]
[26.0519, "o", "\u001b[33m   $ sqlguard leakage dbt --manifest build_ci/manifest.json --replay --catalog lakehouse --catalog-namespace raw --suggest-fix\u001b[0m\r\n"]
[28.7523, "o", "    LEAKY         0.94  models/marts/training_churn.sql\r\n"]
[28.7524, "o", "        L4           orders is bounded by event time only; rows ingested after cutoff_ts (loaded_at) may leak in [orders]\r\n                     in models/intermediate/int_customer_orders_7d.sql\r\n        REPLAY       feature values differ from what was knowable at prediction time\r\n                     in models/marts/training_churn.sql\r\n"]
[28.7524, "o", "        fix L4  [static_and_replay; semantics changed] orders (in models/intermediate/int_customer_orders_7d.sql): Bound loaded_at of orders strictly before labels.cutoff_ts in the join condition, so each prediction only sees facts that had already landed.\r\n"]
[28.7524, "o", "            caveat: rows may drop: it cannot be shown that only the bound changed: a JOINS sits above the values; a clause that reads values derived from orders may filter, limit or merge spine rows\r\n"]
[28.7524, "o", "        suggested change (formatting normalized; the file is not modified; shown against the compiled query with upstream models inlined):\r\n"]
[28.7524, "o", "    --- a/models/intermediate/int_customer_orders_7d.sql\r\n"]
[28.7524, "o", "    +++ b/models/intermediate/int_customer_orders_7d.sql (suggested)\r\n"]
[28.7524, "o", "    @@ -9,6 +9,7 @@\r\n"]
[28.7524, "o", "         ON orders.user_id = labels.customer_id\r\n"]
[28.7524, "o", "         AND orders.ordered_at < labels.cutoff_ts\r\n"]
[28.7525, "o", "         AND orders.ordered_at >= labels.cutoff_ts - INTERVAL '7' DAY\r\n    +    AND orders.loaded_at < labels.cutoff_ts\r\n       GROUP BY\r\n         labels.customer_id,\r\n         labels.cutoff_ts\r\n"]
[31.4414, "o", "    replay: MISMATCH - 50 of 127 rows differ at 4 prediction dates (amount_7d, orders_7d)\r\n"]
[31.4414, "o", "\r\n\u001b[1;36m== 4/11  Apply the suggested fix, rebuild, check again\u001b[0m\r\n\u001b[90m   # The suggested change adds one line to the intermediate model's join:\u001b[0m\r\n"]
[31.4414, "o", "\u001b[33m   $ diff -u --label models/intermediate/int_customer_orders_7d.sql --label suggested models/intermediate/int_customer_orders_7d.sql fix/int_customer_orders_7d.sql\u001b[0m\r\n"]
[31.504, "o", "    --- models/intermediate/int_customer_orders_7d.sql\r\n"]
[31.504, "o", "    +++ suggested\r\n    @@ -10,6 +10,7 @@\r\n     left join {{ source('raw', 'orders') }} as orders\r\n         on orders.user_id = labels.customer_id\r\n         and orders.ordered_at < labels.cutoff_ts\r\n    +    and orders.loaded_at < labels.cutoff_ts\r\n         and orders.ordered_at >= labels.cutoff_ts - interval 7 day\r\n     \r\n     group by labels.customer_id, labels.cutoff_ts\r\n"]
[31.5105, "o", "\u001b[33m   $ cp fix/int_customer_orders_7d.sql models/intermediate/int_customer_orders_7d.sql\u001b[0m\r\n"]
[31.5725, "o", "\u001b[33m   $ dbt build --profiles-dir . --target-path build_ci --no-use-colors\u001b[0m\r\n"]
[35.1309, "o", "    18:31:41  Done. PASS=7 WARN=0 ERROR=0 SKIP=0 NO-OP=0 REUSED=0 TOTAL=7\r\n"]
[35.3779, "o", "\u001b[33m   $ sqlguard leakage dbt --manifest build_ci/manifest.json --replay --catalog lakehouse --catalog-namespace raw\u001b[0m\r\n"]
[37.7479, "o", "    CLEAN         0.00  models/marts/training_churn.sql\r\n"]
[40.4247, "o", "    replay: pass - 127 rows over 4 prediction dates equal what was knowable then\r\n"]
[40.4247, "o", "\r\n\u001b[1;36m== 5/11  Start the stack's approval UI and seed prod.orders\u001b[0m\r\n\u001b[90m   # policy.yaml: every write to the namespace `prod` waits for a person.\u001b[0m\r\n"]
[40.4247, "o", "\u001b[33m   $ python /work/docker/demo-e2e/lake.py seed\u001b[0m\r\n"]
[41.8562, "o", "    catalog> prod.orders: 100 rows (30 cancelled); main is on snapshot 2195760105540568395\r\n"]
[41.8563, "o", "    catalog> branches besides main: none\r\n"]
[42.1019, "o", "\u001b[33m   $ sqlguard serve --catalog lakehouse --store actions.db --policy ...\u001b[0m\r\n"]
[43.9237, "o", "    approval UI at http://127.0.0.1:18765 (loopback only); its one-time link is not shown\r\n"]
[45.3771, "o", "\r\n\u001b[1;36m== 6/11  An agent asks, over MCP, to delete production data\u001b[0m\r\n"]
[45.3771, "o", "\u001b[90m   # The agent is a scripted MCP client (no model, no key): same tools, same answers.\u001b[0m\r\n"]
[45.3772, "o", "\u001b[33m   $ agent.py  # a scripted MCP client; it starts sqlguard-mcp like an IDE does\u001b[0m\r\n"]
[48.6996, "o", "    agent> list_tables\r\n"]
[48.7062, "o", "    tables: prod.orders, raw.churn_labels, raw.customers, raw.orders\r\n"]
[48.7062, "o", "    agent> describe_table {\"table\": \"prod.orders\"}\r\n"]
[48.7303, "o", "    prod.orders: 100 rows, main is on snapshot 2195760105540568395\r\n"]
[48.7304, "o", "    agent> run_sql {\"sql\": \"DELETE FROM prod.orders WHERE status = 'cancelled'\"}\r\n"]
[48.9898, "o", "    status: pending_approval\r\n"]
[48.9899, "o", "    action_id: a989c45dca64499ea89491cda05b5780\r\n    summary: prod.orders: 0 rows added, 30 deleted, 0 modified (of 100)\r\n    reason: DELETE restricted by a WHERE clause\r\n    reason: writes to production always need approval: prod.orders\r\n    reason: dry run affects 30.0% of rows (limit 10%)\r\n    message: Not applied: the change was rehearsed and is waiting for a reviewer's approval; nothing has changed.\r\n"]
[49.2495, "o", "\u001b[33m   $ python /work/docker/demo-e2e/lake.py state\u001b[0m\r\n"]
[49.654, "o", "    catalog> prod.orders: 100 rows (30 cancelled); main is on snapshot 2195760105540568395\r\n"]
