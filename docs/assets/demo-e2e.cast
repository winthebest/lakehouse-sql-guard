[63.5104, "o", "\r\n\u001b[1;36m== 11/11  The audit trail\u001b[0m\r\n"]
[63.5104, "o", "\u001b[90m   # Every submission and decision, including who approved, is in the append-only log.\u001b[0m\r\n"]
[63.5733, "o", "    awaiting_approval  by=-              published=False DELETE FROM prod.orders WHERE status = ?\r\n"]
[63.5733, "o", "    rejected           by=demo-reviewer  published=False DELETE FROM prod.orders WHERE status = ?\r\n    awaiting_approval  by=-              published=False DELETE FROM prod.orders WHERE status = ? AND customer_id\r\n    published          by=demo-reviewer  published=True  DELETE FROM prod.orders WHERE status = ? AND customer_id\r\n    awaiting_approval  by=-              published=False UPDATE prod.orders SET status = ? WHERE id = ?\r\n    stale              by=demo-reviewer  published=False UPDATE prod.orders SET status = ? WHERE id = ?\r\n    awaiting_approval  by=-              published=False RollbackToSnapshot\r\n    maintenance_done   by=demo-reviewer  published=True  RollbackToSnapshot\r\n"]
