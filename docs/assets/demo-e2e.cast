[0.7167, "o", "== starting the stack: Lakekeeper on an S3-compatible store (compose project sqlguard-lakehouse)\r\n"]
[16.8813, "o", "   ready in 17s\r\n"]
[16.9508, "o", "\r\n\u001b[1;36m== 1/11  Load the lakehouse as nightly commits, with late rows\u001b[0m\r\n"]
[16.9509, "o", "\u001b[90m   # Orders land through a nightly job: one Iceberg commit per night, and 1 in 5 rows\u001b[0m\r\n\u001b[90m   # arrive 1-3 days late. Real commits, written to Lakekeeper over REST.\u001b[0m\r\n\u001b[90m   # They are written seconds apart, so each records the night it stands for in the\u001b[0m\r\n\u001b[90m   # snapshot property sqlguard.logical-ts; replay pins to that, not to commit time.\u001b[0m\r\n\u001b[33m   $ python /work/examples/dbt-lakehouse/load-lakehouse.py --catalog lakehouse\u001b[0m\r\n"]
[19.3618, "o", "    raw.orders: 283 orders in 29 nightly commits (55 late rows); 40 customers, 127 labels\r\n"]
[19.3618, "o", "    each commit records the night it stands for in the snapshot property sqlguard.logical-ts: replay pins to it, because the commits were written seconds apart\r\n"]
[19.4455, "o", "\u001b[33m   $ python /work/docker/demo-e2e/lake.py history raw.orders\u001b[0m\r\n"]
[20.6909, "o", "    catalog> raw.orders: 29 snapshots; commit time -> logical time recorded on it\r\n"]
[20.691, "o", "               2900741279699979514  18:31:24.587  ->  2026-09-02T02:00:00\r\n               6013315284401816300  18:31:24.624  ->  2026-09-03T02:00:00\r\n               ... 25 more\r\n               29682958563232053  18:31:25.435  ->  2026-09-29T02:00:00\r\n               4568031232042787185  18:31:25.469  ->  2026-10-01T02:00:00\r\n"]
[20.7537, "o", "\r\n\u001b[1;36m== 2/11  dbt build a small training-set project\u001b[0m\r\n"]
[20.7537, "o", "\u001b[90m   # examples/dbt-lakehouse: raw sources -> int_customer_orders_7d -> training_churn.\u001b[0m\r\n"]
[20.8421, "o", "\u001b[33m   $ dbt build --profiles-dir . --target-path build_ci --no-use-colors\u001b[0m\r\n"]
[23.0652, "o", "    18:31:29  Running with dbt=1.12.6\r\n"]
[23.2791, "o", "    18:31:29  Registered adapter: duckdb=1.11.1\r\n"]
[23.3109, "o", "    18:31:29  Unable to do partial parsing because saved manifest not found. Starting full parse.\r\n"]
[24.1912, "o", "    18:31:30  Found 3 models, 4 data tests, 3 sources, 511 macros\r\n"]
[24.1921, "o", "    18:31:30  \r\n"]
[24.1923, "o", "    18:31:30  Concurrency: 1 threads (target='dev')\r\n"]
[24.1927, "o", "    18:31:30  \r\n"]
[24.6701, "o", "    18:31:30  1 of 7 START sql view model main.int_customer_orders_7d ........................ [RUN]\r\n"]
[25.5578, "o", "    18:31:31  1 of 7 OK created sql view model main.int_customer_orders_7d ................... [OK in 0.89s]\r\n"]
[25.5584, "o", "    18:31:31  2 of 7 START sql view model main.stg_customers ................................. [RUN]\r\n"]
[25.5825, "o", "    18:31:31  2 of 7 OK created sql view model main.stg_customers ............................ [OK in 0.02s]\r\n"]
[25.5833, "o", "    18:31:31  3 of 7 START sql table model main.training_churn ............................... [RUN]\r\n"]
[25.6345, "o", "    18:31:31  3 of 7 OK created sql table model main.training_churn .......................... [OK in 0.05s]\r\n"]
[25.6352, "o", "    18:31:31  4 of 7 START test not_null_training_churn_churned .............................. [RUN]\r\n"]
[25.6564, "o", "    18:31:31  4 of 7 PASS not_null_training_churn_churned .................................... [PASS in 0.02s]\r\n"]
