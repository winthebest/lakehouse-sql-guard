[49.7239, "o", "\u001b[90m   # the UI shows the diff between main (base) and that branch (head).\u001b[0m\r\n\u001b[33m   $ sqlguard approvals list --store actions.db   # the same queue, in a terminal\u001b[0m\r\n"]
[50.1809, "o", "    ID         STATE            TABLE                    CHANGE         REQUESTER    DEADLINE\r\n"]
