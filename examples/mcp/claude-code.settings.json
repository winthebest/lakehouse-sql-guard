{
  "permissions": {
    "allow": [
      "mcp__lakehouse-guard__list_tables",
      "mcp__lakehouse-guard__describe_table",
      "mcp__lakehouse-guard__get_action_status",
      "mcp__lakehouse-guard__check_training_sql"
    ],
    "deny": [
      "Bash(sqlguard approvals approve:*)",
      "Bash(sqlguard approvals reject:*)",
      "Bash(sqlguard serve:*)",
      "Bash(sqlguard:*)",
      "Bash(uv run sqlguard:*)",
      "Bash(uvx:*)",
      "Bash(python -m sqlguard:*)",
      "Bash(python3 -m sqlguard:*)",
      "Bash(sqlguard-mcp:*)",
      "Bash(sqlite3:*)",
      "Bash(duckdb:*)",
      "Bash(script:*)",
      "Bash(expect:*)",
      "Bash(unbuffer:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)",
      "Bash(zsh -c:*)",
      "Bash(env:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Read(~/.pyiceberg.yaml)",
      "Read(~/.claude.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/lakehouse-guard/**)",
      "Edit(~/.config/lakehouse-guard/**)",
      "Read(~/.local/state/lakehouse-guard/**)",
      "Edit(~/.local/state/lakehouse-guard/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.mozilla/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "credentials": {
      "envVars": [
        {
          "name": "LAKEHOUSE_CATALOG_URI",
          "mode": "deny"
        },
        {
          "name": "LAKEHOUSE_CATALOG_CREDENTIAL",
          "mode": "deny"
        },
        {
          "name": "PYICEBERG_CATALOG__LAKE__URI",
          "mode": "deny"
        },
        {
          "name": "PYICEBERG_CATALOG__LAKE__CREDENTIAL",
          "mode": "deny"
        }
      ],
      "files": [
        {
          "path": "~/.pyiceberg.yaml",
          "mode": "deny"
        },
        {
          "path": "~/.claude.json",
          "mode": "deny"
        },
        {
          "path": "~/.config/lakehouse-guard",
          "mode": "deny"
        },
        {
          "path": "~/.local/state/lakehouse-guard",
          "mode": "deny"
        }
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/Library/Application Support/Google/Chrome",
        "~/Library/Cookies",
        "~/Library/Safari",
        "~/.config/google-chrome",
        "~/.mozilla"
      ],
      "denyWrite": [
        "~/.config/lakehouse-guard",
        "~/.local/state/lakehouse-guard"
      ]
    }
  }
}
