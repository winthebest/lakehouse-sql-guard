{
  "mcpServers": {
    "lakehouse-sql-guard": {
      "command": "uvx",
      "args": [
        "--from",
        "lakehouse-sql-guard[mcp] @ git+https://github.com/winthebest/lakehouse-sql-guard",
        "sqlguard-mcp",
        "--warehouse",
        "/ABSOLUTE/PATH/TO/warehouse",
        "--policy",
        "/ABSOLUTE/PATH/TO/policy.yaml",
        "--audit-log",
        "/ABSOLUTE/PATH/TO/audit.jsonl",
        "--scope-table",
        "db.orders",
        "--spec-dir",
        "/ABSOLUTE/PATH/TO/leakage-specs"
      ]
    }
  }
}
