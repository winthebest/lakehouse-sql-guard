  "nodes": {
    "model.jaffle_churn.int_customer_features": {
      "columns": {},
      "compiled_code": "select\n    customer_id,\n    count(*) as lifetime_orders,\n    sum(amount) as lifetime_amount,\n    max(ordered_at) as last_order_at\n\nfrom \"jaffle\".\"main\".\"stg_orders\"\n\ngroup by customer_id",
      "config": {
        "materialized": "view",
        "meta": {}
      },
      "depends_on": {
        "nodes": [
          "model.jaffle_churn.stg_orders"
        ]
      },
      "meta": {},
      "name": "int_customer_features",
      "original_file_path": "models/intermediate/int_customer_features.sql",
      "relation_name": "\"jaffle\".\"main\".\"int_customer_features\"",
      "resource_type": "model",
      "unique_id": "model.jaffle_churn.int_customer_features"
    },
    "model.jaffle_churn.int_customer_recent_orders": {
      "columns": {},
      "compiled_code": "select\n    labels.customer_id,\n    labels.cutoff_ts,\n    count(orders.order_id) as orders_90d,\n    coalesce(sum(orders.amount), 0) as amount_90d\n\nfrom \"jaffle\".\"raw\".\"churn_labels\" as labels\n\nleft join \"jaffle\".\"main\".\"stg_orders\" as orders\n    on orders.customer_id = labels.customer_id\n    and orders.ordered_at < labels.cutoff_ts\n    and orders.loaded_at < labels.cutoff_ts\n    and orders.ordered_at >= labels.cutoff_ts - interval 90 day\n\ngroup by labels.customer_id, labels.cutoff_ts",
      "config": {
        "materialized": "view",
        "meta": {}
      },
      "depends_on": {
        "nodes": [
          "source.jaffle_churn.raw.churn_labels",
          "model.jaffle_churn.stg_orders"
        ]
      },
      "meta": {},
      "name": "int_customer_recent_orders",
      "original_file_path": "models/intermediate/int_customer_recent_orders.sql",
      "relation_name": "\"jaffle\".\"main\".\"int_customer_recent_orders\"",
      "resource_type": "model",
      "unique_id": "model.jaffle_churn.int_customer_recent_orders"
    },
    "model.jaffle_churn.stg_customers": {
      "columns": {},
      "compiled_code": "select\n    id as customer_id,\n    first_name,\n    last_name\n\nfrom \"jaffle\".\"raw\".\"customers\"",
      "config": {
        "materialized": "view",
        "meta": {}
      },
      "depends_on": {
