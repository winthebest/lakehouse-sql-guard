      "meta": {},
      "name": "stg_customers",
      "original_file_path": "models/staging/stg_customers.sql",
      "relation_name": "\"jaffle\".\"main\".\"stg_customers\"",
      "resource_type": "model",
      "unique_id": "model.jaffle_churn.stg_customers"
    },
    "model.jaffle_churn.stg_orders": {
      "columns": {},
      "compiled_code": "select\n    id as order_id,\n    user_id as customer_id,\n    ordered_at,\n    loaded_at,\n    status,\n    amount\n\nfrom \"jaffle\".\"raw\".\"orders\"",
      "config": {
        "materialized": "view",
        "meta": {}
      },
      "depends_on": {
        "nodes": [
          "source.jaffle_churn.raw.orders"
        ]
