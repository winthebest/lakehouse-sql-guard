      "original_file_path": "models/staging/stg_orders.sql",
      "relation_name": "\"jaffle\".\"main\".\"stg_orders\"",
      "resource_type": "model",
      "unique_id": "model.jaffle_churn.stg_orders"
    },
    "model.jaffle_churn.training_churn_clean": {
      "columns": {},
      "compiled_code": "select\n    labels.customer_id,\n    labels.cutoff_ts,\n    labels.churned,\n    recent.orders_90d,\n    recent.amount_90d,\n    customers.first_name\n\nfrom \"jaffle\".\"raw\".\"churn_labels\" as labels\n\nleft join \"jaffle\".\"main\".\"int_customer_recent_orders\" as recent\n    on recent.customer_id = labels.customer_id\n    and recent.cutoff_ts = labels.cutoff_ts\n\nleft join \"jaffle\".\"main\".\"stg_customers\" as customers\n    on customers.customer_id = labels.customer_id",
      "config": {
        "materialized": "table",
        "meta": {
          "leakage": {
            "role": "training_set"
          }
        }
      },
      "depends_on": {
        "nodes": [
          "source.jaffle_churn.raw.churn_labels",
          "model.jaffle_churn.int_customer_recent_orders",
          "model.jaffle_churn.stg_customers"
        ]
      },
      "meta": {
        "leakage": {
          "role": "training_set"
        }
      },
      "name": "training_churn_clean",
      "original_file_path": "models/marts/training_churn_clean.sql",
      "relation_name": "\"jaffle\".\"main\".\"training_churn_clean\"",
      "resource_type": "model",
      "unique_id": "model.jaffle_churn.training_churn_clean"
    },
    "model.jaffle_churn.training_churn_leaky": {
      "columns": {},
      "compiled_code": "select\n    labels.customer_id,\n    labels.cutoff_ts,\n    labels.churned,\n    features.lifetime_orders,\n    features.lifetime_amount,\n    customers.first_name\n\nfrom \"jaffle\".\"raw\".\"churn_labels\" as labels\n\nleft join \"jaffle\".\"main\".\"int_customer_features\" as features\n    on features.customer_id = labels.customer_id\n\nleft join \"jaffle\".\"main\".\"stg_customers\" as customers\n    on customers.customer_id = labels.customer_id",
      "config": {
        "materialized": "table",
        "meta": {
